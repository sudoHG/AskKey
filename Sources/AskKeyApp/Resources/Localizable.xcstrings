{
  "sourceLanguage": "en",
  "strings": {
    "Connect Ask Key to %@ and configure credential discovery before SSH.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Connect Ask Key to %@ and configure credential discovery before SSH." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "连接 Ask Key 到 %@，并配置 SSH 连接前的凭证查询。" } },
        "qps-ploc": { "stringUnit": { "state": "translated", "value": "[!!Connect Ask Key to %@ and configure credential discovery before SSH.!!]" } }
      }
    },
    "Configuration files are backed up before changes. If discovery setup fails, the verified MCP connection is kept. Start a new task after setup.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Configuration files are backed up before changes. If discovery setup fails, the verified MCP connection is kept. Start a new task after setup." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "修改前会备份配置。如果连接前查询的配置失败，已验证的 MCP 连接会保留。配置完成后请新开任务。" } },
        "qps-ploc": { "stringUnit": { "state": "translated", "value": "[!!Configuration files are backed up before changes. If discovery setup fails, the verified MCP connection is kept. Start a new task after setup.!!]" } }
      }
    },
    "Ask Key will back up %@'s user settings, add Ask Key and credential discovery before SSH, then verify the connection and configuration.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Ask Key will back up %@'s user settings, add Ask Key and credential discovery before SSH, then verify the connection and configuration." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "Ask Key 会先备份 %@ 的用户设置，接入 MCP 并配置 SSH 连接前的凭证查询，再验证连接并检查配置。" } },
        "qps-ploc": { "stringUnit": { "state": "translated", "value": "[!!Ask Key will back up %@'s user settings, add Ask Key and credential discovery before SSH, then verify the connection and configuration.!!]" } }
      }
    },
    "Before the first direct SSH connection in a turn, ask the agent to check the credential catalog. Credential access still needs approval. If the catalog is unavailable or its callback is lost, the reminder stops blocking after 30 seconds without progress.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Before the first direct SSH connection in a turn, ask the agent to check the credential catalog. Credential access still needs approval. If the catalog is unavailable or its callback is lost, the reminder stops blocking after 30 seconds without progress." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "每轮首次直接连接 SSH 前，提醒 Agent 查询凭证目录。使用凭证仍需审批。目录不可用或完成通知丢失时，连续 30 秒没有进展便停止拦截，避免任务一直卡住。" } },
        "qps-ploc": { "stringUnit": { "state": "translated", "value": "[!!Before the first direct SSH connection in a turn, ask the agent to check the credential catalog. Credential access still needs approval. If the catalog is unavailable or its callback is lost, the reminder stops blocking after 30 seconds without progress.!!]" } }
      }
    },
    "Credential discovery setup was cancelled. The verified MCP connection was kept. Check again before continuing.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Credential discovery setup was cancelled. The verified MCP connection was kept. Check again before continuing." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "连接前查询凭证的配置已取消，已验证的 MCP 连接会保留。继续前请重新检查。" } },
        "qps-ploc": { "stringUnit": { "state": "translated", "value": "[!!Credential discovery setup was cancelled. The verified MCP connection was kept. Check again before continuing.!!]" } }
      }
    },
    "%@ was not found. Install or open it, then check again.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "%@ was not found. Install or open it, then check again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "未找到 %@。请先安装或打开它，再重新检查。" } },
        "qps-ploc": { "stringUnit": { "state": "translated", "value": "[!!%@ was not found. Install or open it, then check again.!!]" } }
      }
    },
    "Could not read %@'s local configuration. Check again.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Could not read %@'s local configuration. Check again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "未能读取 %@ 的本机配置，请重新检查。" } },
        "qps-ploc": { "stringUnit": { "state": "translated", "value": "[!!Could not read %@'s local configuration. Check again.!!]" } }
      }
    },
    "Local settings changed after review. Check again before confirming.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Local settings changed after review. Check again before confirming." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "本机配置在检查后发生了变化，请重新检查后再确认。" } },
        "qps-ploc": { "stringUnit": { "state": "translated", "value": "[!!Local settings changed after review. Check again before confirming.!!]" } }
      }
    },
    "Before the first direct SSH command in each turn, ask Codex to check the credential catalog. Credential access still requires its existing approval. If this check is unavailable or takes over three seconds, Codex may continue without it.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Before the first direct SSH command in each turn, ask Codex to check the credential catalog. Credential access still requires its existing approval. If this check is unavailable or takes over three seconds, Codex may continue without it." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "在每轮首次直接运行 SSH 前，提醒 Codex 查询凭证目录。实际使用凭证仍按原有规则审批。检查不可用或超过三秒时，Codex 可能直接继续。" } },
        "qps-ploc": { "stringUnit": { "state": "translated", "value": "[!!Before the first direct SSH command in each turn, ask Codex to check the credential catalog. Credential access still requires its existing approval. If this check is unavailable or takes over three seconds, Codex may continue without it.!!]" } }
      }
    },
    "Ask Key will back up Codex's user-level configuration, add Ask Key and credential discovery before SSH, then verify both. Only this Ask Key hook will be trusted.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Ask Key will back up Codex's user-level configuration, add Ask Key and credential discovery before SSH, then verify both. Only this Ask Key hook will be trusted." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "Ask Key 会先备份 Codex 的用户配置，再添加接入和 SSH 连接前查询凭证，并分别验证。仅信任本次展示的 Ask Key 检查规则。" } },
        "qps-ploc": { "stringUnit": { "state": "translated", "value": "[!!Ask Key will back up Codex's user-level configuration, add Ask Key and credential discovery before SSH, then verify both. Only this Ask Key hook will be trusted.!!]" } }
      }
    },
