    "pairing.code.onlyHere": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pairing code appears only on this screen. Ask Key never sends it in a notification or a message."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对码只会显示在这个页面上。请旨绝不会通过通知或消息发送配对码。"
          }
        }
      }
    },
    "pairing.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm Pairing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认配对"
          }
        }
      }
    },
    "pairing.confirm.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID or Touch ID was cancelled. Nothing was sent; you can confirm again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面容 ID 或触控 ID 已取消，没有发送任何内容。你可以再次确认。"
          }
        }
      }
    },
    "pairing.confirm.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID or Touch ID didn't succeed. Nothing was sent; you can confirm again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面容 ID 或触控 ID 验证未通过，没有发送任何内容。你可以再次确认。"
          }
        }
      }
    },
    "pairing.confirm.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirming asks for Face ID or Touch ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认时需要面容 ID 或触控 ID。"
          }
        }
      }
    },
    "pairing.confirm.reason %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair with “%@” to approve its agent requests"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与“%@”配对，以审批它的 Agent 请求"
          }
        }
      }
    },
    "pairing.confirm.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID or Touch ID isn't available to Ask Key right now. Check Settings → Ask Key. Nothing was sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请旨暂时无法使用面容 ID 或触控 ID。请检查“设置”→“请旨”。没有发送任何内容。"
          }
        }
      }
    },
    "pairing.confirmed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmed on this iPhone. Enter the code on your Mac to finish pairing. Agent requests from that Mac will then appear in Ask Key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在这台 iPhone 上确认。请在 Mac 上输入配对码以完成配对，之后那台 Mac 上 Agent 的请求会出现在请旨里。"
          }
        }
      }
    },
    "pairing.failed.cancelledByMac": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing was cancelled on the Mac. Nothing was stored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对已在 Mac 上取消，没有保存任何内容。"
          }
        }
      }
    },
    "pairing.failed.conflictingChallenge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing stopped because a different answer arrived for this pairing. Nothing was stored. Cancel on your Mac and start again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次配对收到了另一个不同的回应，配对已停止，没有保存任何内容。请在 Mac 上取消后重新开始。"
          }
        }
      }
    },
    "pairing.failed.deviceLimitReached": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone is already paired with 8 Macs. Remove one, then pair again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 已与 8 台 Mac 配对。请先移除一台，再重新配对。"
          }
        }
      }
    },
    "pairing.failed.ended": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing ended. Nothing was stored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对已结束，没有保存任何内容。"
          }
        }
      }
    },
    "pairing.failed.expired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pairing session expired. Nothing was stored. Start again on your Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对已超时，没有保存任何内容。请在 Mac 上重新开始。"
          }
        }
      }
    },
    "pairing.failed.keyConflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac's keys conflict with a device that is already paired. Nothing was stored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 的密钥与已配对的设备冲突，没有保存任何内容。"
          }
        }
      }
    },
    "pairing.failed.noChallenge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac didn't answer within 60 seconds, so this iPhone withdrew its request. Cancel pairing on your Mac, and don't enter any code there."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 在 60 秒内没有回应，这台 iPhone 已撤回请求。请在 Mac 上取消配对，不要在 Mac 上输入任何配对码。"
          }
        }
      }
    },
    "pairing.failed.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing Failed"
