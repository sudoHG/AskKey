    "list.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No paired Macs yet. On your Mac, open Ask Key's Settings, choose Devices, then Pair a Device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有配对的 Mac。请在 Mac 上打开请旨的“设置”，选择“设备”，再选择“配对设备”。"
          }
        }
      }
    },
