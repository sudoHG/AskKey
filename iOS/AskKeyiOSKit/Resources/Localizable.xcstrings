    "list.remove.confirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone stops approving this Mac's requests at once and drops the pending ones. Ask Key also tells the Mac, which stops trusting this iPhone only when it receives that notice; until then, a decision already sent can still apply. To end approval on the Mac at once, remove this iPhone there too."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 会立即停止审批这台 Mac 的请求，并丢弃待处理的请求。请旨也会通知 Mac，Mac 收到通知后才会不再信任这台 iPhone，在此之前已发出的决定仍可能生效。如需立即在 Mac 上结束审批，请也在 Mac 上的请旨中移除这台 iPhone。"
          }
        }
      }
    },
    "list.remove.confirmTitle %@": {
      "extractionState": "manual",
