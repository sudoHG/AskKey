    "history.by.notApplied %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” couldn't apply this iPhone's decision as signed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”无法按签名执行这台 iPhone 的决定。"
          }
        }
      }
    },
    "history.clear": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear All History"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除全部记录"
          }
        }
      }
    },
    "history.clear.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears history on this iPhone only. Access Records on your Macs aren't affected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只清除这台 iPhone 上的记录。Mac 上的“访问记录”不受影响。"
          }
        }
      }
    },
    "history.clear.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear All History?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除全部记录？"
          }
        }
      }
    },
    "history.detail.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The command, folder and delivered names aren't kept on the iPhone. For the full record, open Access Records in Ask Key on your Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令、运行目录和交出的变量名不保存在 iPhone 上。要看完整记录，请在 Mac 上打开请旨的“访问记录”。"
          }
        }
      }
    },
    "history.empty.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests sent to this iPhone are listed here after they end, for 30 days."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发到这台 iPhone 的请求结束后会记在这里，保留 30 天。"
          }
        }
      }
    },
    "history.empty.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
