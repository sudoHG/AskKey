      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Key couldn't reach iCloud. Check the connection. If your iPhone asked about wireless data, allow WLAN & Cellular Data in Settings → Ask Key → Wireless Data. Also check your Apple Account in Settings, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请旨无法连接 iCloud。请检查网络。如果 iPhone 询问过无线数据权限，请在“设置”→“请旨”→“无线数据”中选择“无线局域网与蜂窝网络”。另请在“设置”中检查你的 Apple 账户，然后重试。"
          }
        }
      }
    },
    "welcome.failure.keyCreationFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Secure Enclave didn't create the keys. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全隔区没有生成密钥。请重试。"
          }
        }
      }
    },
    "welcome.failure.keychainFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Key couldn't read or save its keys on this iPhone. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请旨无法在这台 iPhone 上读取或保存密钥。请重试。"
          }
        }
      }
    },
    "welcome.failure.networkUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Key couldn't reach iCloud. Check the connection. If your iPhone asked about wireless data, allow WLAN & Cellular Data in Settings → Ask Key → Wireless Data, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请旨无法连接 iCloud。请检查网络。如果 iPhone 询问过无线数据权限，请在“设置”→“请旨”→“无线数据”中选择“无线局域网与蜂窝网络”，然后重试。"
          }
        }
      }
    },
    "welcome.failure.noBiometry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone has neither Face ID nor Touch ID, so it can't confirm a pairing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 没有面容 ID 或触控 ID，无法确认配对。"
          }
        }
      }
    },
    "welcome.failure.noSecureEnclave": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone has no Secure Enclave, so it can't keep Ask Key's keys safe and can't pair."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 没有安全隔区，无法安全地保存请旨的密钥，因此不能配对。"
          }
        }
      }
    },
    "welcome.failure.passcodeNotSet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a passcode and Face ID or Touch ID in Settings first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在“设置”中设置密码以及面容 ID 或触控 ID。"
          }
        }
      }
    },
    "welcome.failure.touchIDNotEnrolled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up Touch ID in Settings first. Ask Key confirms every pairing with Touch ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在“设置”中设置触控 ID。请旨每次配对都要用触控 ID 确认。"
          }
        }
      }
    },
    "welcome.requirement.biometry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You confirm every pairing with Face ID or Touch ID. The passcode alone is not enough."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次配对都要用面容 ID 或触控 ID 确认，只用密码不行。"
          }
        }
      }
    },
    "welcome.requirement.icloud": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac and this iPhone exchange encrypted messages through iCloud, so both must use the same Apple Account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 与这台 iPhone 通过 iCloud 交换加密消息，所以两台设备必须登录同一个 Apple 账户。"
          }
        }
      }
    },
    "welcome.requirement.notifications": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Key asks to send notifications, so you see when your Mac checks that it can reach this iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请旨会请求发送通知，这样 Mac 检查能否联系到这台 iPhone 时，你能看到提示。"
          }
        }
      }
    },
    "welcome.requirement.secureEnclave": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone's keys are created in its Secure Enclave and never leave it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 的密钥在它的安全隔区中生成，永远不会离开它。"
          }
        }
      }
    },
    "welcome.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Key on this iPhone pairs with Ask Key on your Mac. First it checks that this iPhone can keep the pairing safe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 上的请旨会与 Mac 上的请旨配对。开始前，它会先检查这台 iPhone 能否安全地保存配对。"
          }
        }
      }
    },
    "welcome.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair This iPhone with Your Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将这台 iPhone 与你的 Mac 配对"
          }
        }
      }
    },
    "welcome.tryAgain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "welcome.wirelessData": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some iPhones ask whether Ask Key may use wireless data the first time it goes online. Choose WLAN & Cellular Data, or Ask Key can't reach iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分 iPhone 会在请旨首次联网时询问是否允许使用无线数据。请选择“无线局域网与蜂窝网络”，否则请旨无法连接 iCloud。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
