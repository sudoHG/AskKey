    "mac.status.approving": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone can approve agents' requests to use credentials on this Mac. Allowing always needs Face ID or Touch ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 可以审批 Agent 使用这台 Mac 上凭证的请求。允许时始终需要面容 ID 或触控 ID。"
          }
        }
      }
    },
    "mac.status.notApproving": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone can't approve agents' requests to use credentials on this Mac. To approve them, remove this Mac and pair it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 不能审批 Agent 使用这台 Mac 上凭证的请求。如需审批，请移除这台 Mac 后重新配对。"
          }
        }
      }
    },
    "pairing.approval %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirming lets this iPhone approve agents' requests to use credentials on “%@”. Each request shows the agent, the credential, the command and folder, and the names it's delivered as, never a credential value. Allowing always needs Face ID or Touch ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认后，这台 iPhone 可以审批 Agent 使用“%@”上凭证的请求。每个请求会显示 Agent、凭证、命令、目录和交出的名称，绝不包括凭证的值。允许时始终需要面容 ID 或触控 ID。"
          }
        }
      }
    },
    "pairing.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel Pairing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消配对"
          }
        }
      }
    },
