    "list.account.restricted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is restricted on this iPhone, so your Macs can't reach it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 的 iCloud 受到限制，Mac 无法联系它。"
          }
        }
      }
    },
    "list.account.signedOut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is signed out, so your Macs can't reach this iPhone. Sign in with the same Apple Account as your Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 已退出登录，Mac 无法联系这台 iPhone。请用与 Mac 相同的 Apple 账户登录。"
          }
        }
      }
    },
    "list.account.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Key can't reach iCloud right now, so your Macs can't reach this iPhone. Check the connection and that Ask Key may use wireless data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请旨暂时无法连接 iCloud，Mac 也无法联系这台 iPhone。请检查网络，并确认已允许请旨使用无线数据。"
          }
        }
      }
    },
    "list.empty.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After pairing, a Mac sends its agents' requests here when you're away from it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对后，Mac 上 Agent 的请求会在你不在 Mac 前时发到这里。"
          }
        }
      }
    },
    "list.empty.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Paired Macs Yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有配对的 Mac"
          }
        }
      }
    },
    "list.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When an agent on one of these Macs wants a credential and you're away, the request comes to this iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些 Mac 上的 Agent 想用凭证、而你不在 Mac 前时，请求会发到这台 iPhone。"
          }
        }
      }
    },
