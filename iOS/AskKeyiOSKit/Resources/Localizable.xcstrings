    "mac.stop.confirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone stops showing this Mac's requests at once and drops the pending ones. To turn approval off on the Mac too, use Ask Key on the Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 会立即不再显示这台 Mac 的请求，并丢弃待处理的请求。如需在 Mac 上也关闭审批，请在 Mac 上的请旨中操作。"
          }
        }
      }
    },
    "mac.stop.confirmTitle %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop approving requests from “%@”?"
