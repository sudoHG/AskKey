    "list.account.restricted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is restricted on this iPhone, so your Macs can't reach it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 的 iCloud 受到限制，Mac 无法联系它。"
          }
        }
      }
    },
    "list.account.signedOut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is signed out, so your Macs can't reach this iPhone. Sign in with the same Apple Account as your Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 已退出登录，Mac 无法联系这台 iPhone。请用与 Mac 相同的 Apple 账户登录。"
          }
        }
      }
    },
    "list.account.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Key can't reach iCloud right now, so your Macs can't reach this iPhone. Check the connection and that Ask Key may use wireless data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请旨暂时无法连接 iCloud，Mac 也无法联系这台 iPhone。请检查网络，并确认已允许请旨使用无线数据。"
          }
        }
      }
    },
    "list.approver": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approves agent requests"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审批 Agent 请求"
          }
        }
      }
    },
    "list.deliveries.polling %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · found when Ask Key checked its inbox"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 请旨检查收件箱时发现"
