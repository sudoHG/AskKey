{
  "sourceLanguage": "en",
  "strings": {
    "approver.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认"
          }
        }
      }
    },
    "approver.confirming": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirming…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在确认…"
          }
        }
      }
    },
    "approver.field": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approver code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审批码"
          }
        }
      }
    },
    "approver.onlyOnMac": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The approver code appears only on that Mac's screen. Never enter a code that someone sends you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审批码只会显示在那台 Mac 的屏幕上。别人发给你的代码，一律不要输入。"
          }
        }
      }
    },
    "approver.problem.invalidCode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the six digits shown on the Mac. Nothing was sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 Mac 上显示的六位数字。没有发送任何内容。"
          }
        }
      }
    },
    "approver.problem.notSent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The confirmation couldn't be sent in time. Start again on the Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认未能及时发送。请在 Mac 上重新开始。"
          }
        }
      }
    },
    "approver.problem.other": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出了点问题，请重试。"
          }
        }
      }
    },
    "approver.problem.retrying": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud hasn't saved the confirmation yet. Ask Key keeps trying for a few minutes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 还没有保存这个确认。请旨会在几分钟内继续尝试。"
          }
        }
      }
    },
    "approver.reason %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve requests from “%@”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审批“%@”的请求"
          }
        }
      }
    },
    "approver.sending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending the confirmation…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在发送确认…"
          }
        }
      }
    },
    "approver.sent %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent to “%@”. If the code matched, the Mac turns approval on and starts sending this iPhone its requests. This iPhone can't tell whether it did; check the Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发送给“%@”。如果审批码正确，Mac 会开启审批，并开始把请求发到这台 iPhone。这台 iPhone 无法得知是否开启成功，请在 Mac 上查看。"
          }
        }
      }
    },
    "approver.subtitle %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the approver code that Ask Key shows on “%@”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入“%@”上的请旨显示的审批码。"
          }
        }
      }
    },
    "approver.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve Requests"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审批请求"
          }
        }
      }
    },
    "approver.whatArrives": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After this, the Mac sends this iPhone its agents' requests: the agent, the credential's name, the command, the folder and the delivered names, never a value. Allowing always needs Face ID or Touch ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后，这台 Mac 会把 Agent 的请求发到这台 iPhone：包括 Agent、凭证名称、命令、目录和交出的名称，绝不包括凭证的值。允许时始终需要面容 ID 或触控 ID。"
          }
        }
      }
    },
    "common.appName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请旨"
          }
        }
      }
    },
    "common.cancel": {
      "extractionState": "manual",
