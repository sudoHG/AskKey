      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removed “%@”, but the Mac couldn't be told. Remove this iPhone in Ask Key on the Mac too."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除“%@”，但没能通知这台 Mac。请也在 Mac 上的请旨中移除这台 iPhone。"
