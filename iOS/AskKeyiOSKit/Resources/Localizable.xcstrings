          "stringUnit": {
            "state": "translated",
            "value": "这个版本的请旨没有配置 iCloud，因此不能配对。"
          }
        }
      }
    },
    "welcome.failure.faceIDNotEnrolled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up Face ID in Settings first. Ask Key confirms every pairing with Face ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在“设置”中设置面容 ID。请旨每次配对都要用面容 ID 确认。"
          }
        }
      }
    },
    "welcome.failure.iCloudFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud didn't finish setting up Ask Key's inbox. Try again in a moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 没能完成请旨收件箱的设置。请稍后重试。"
          }
        }
      }
    },
    "welcome.failure.iCloudRestricted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is restricted on this iPhone, for example by Screen Time or a device management profile."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 的 iCloud 受到限制，例如被“屏幕使用时间”或设备管理描述文件限制。"
          }
        }
      }
    },
    "welcome.failure.iCloudSignedOut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud in Settings with the same Apple Account as your Mac, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中用与 Mac 相同的 Apple 账户登录 iCloud，然后重试。"
          }
        }
      }
    },
    "welcome.failure.iCloudUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Key couldn't reach iCloud. Check the connection. If your iPhone asked about wireless data, allow WLAN & Cellular Data in Settings → Ask Key → Wireless Data. Also check your Apple Account in Settings, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请旨无法连接 iCloud。请检查网络。如果 iPhone 询问过无线数据权限，请在“设置”→“请旨”→“无线数据”中选择“无线局域网与蜂窝网络”。另请在“设置”中检查你的 Apple 账户，然后重试。"
          }
        }
      }
    },
    "welcome.failure.keyCreationFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Secure Enclave didn't create the keys. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全隔区没有生成密钥。请重试。"
          }
        }
      }
    },
    "welcome.failure.keychainFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Key couldn't read or save its keys on this iPhone. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请旨无法在这台 iPhone 上读取或保存密钥。请重试。"
          }
        }
      }
    },
    "welcome.failure.networkUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Key couldn't reach iCloud. Check the connection. If your iPhone asked about wireless data, allow WLAN & Cellular Data in Settings → Ask Key → Wireless Data, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请旨无法连接 iCloud。请检查网络。如果 iPhone 询问过无线数据权限，请在“设置”→“请旨”→“无线数据”中选择“无线局域网与蜂窝网络”，然后重试。"
          }
        }
      }
    },
    "welcome.failure.noBiometry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone has neither Face ID nor Touch ID, so it can't confirm a pairing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 没有面容 ID 或触控 ID，无法确认配对。"
          }
        }
      }
    },
    "welcome.failure.noSecureEnclave": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone has no Secure Enclave, so it can't keep Ask Key's keys safe and can't pair."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 没有安全隔区，无法安全地保存请旨的密钥，因此不能配对。"
          }
        }
      }
    },
    "welcome.failure.passcodeNotSet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a passcode and Face ID or Touch ID in Settings first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在“设置”中设置密码以及面容 ID 或触控 ID。"
          }
        }
      }
    },
    "welcome.failure.touchIDNotEnrolled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up Touch ID in Settings first. Ask Key confirms every pairing with Touch ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在“设置”中设置触控 ID。请旨每次配对都要用触控 ID 确认。"
          }
        }
      }
    },
    "welcome.point.biometry.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Denying doesn't. Someone holding your phone can't allow for you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝不需要。拿到你手机的人无法替你允许。"
          }
        }
      }
    },
    "welcome.point.faceID.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowing needs Face ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许要用面容 ID"
          }
        }
      }
    },
    "welcome.point.icloud.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone and the Mac must use the same Apple Account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 和 Mac 需登录同一个 Apple 账户。"
          }
        }
      }
    },
    "welcome.point.icloud.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted through your iCloud"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过你的 iCloud 加密传递"
          }
        }
      }
    },
    "welcome.point.touchID.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowing needs Touch ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许要用触控 ID"
          }
        }
      }
    },
    "welcome.point.values.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone receives only what the request is for, never a credential value."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 只收到请求说明，从不收到凭证的值。"
          }
        }
      }
    },
    "welcome.point.values.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Credentials stay on the Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "凭证留在 Mac 上"
          }
        }
      }
    },
    "welcome.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you're away from your Mac, an agent's request to use a credential comes here for you to allow or deny."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你不在 Mac 前时，Agent 想用凭证的请求会发到这里，由你允许或拒绝。"
          }
        }
      }
    },
    "welcome.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide agent requests on your iPhone"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上处理 Agent 的请求"
          }
        }
      }
    },
    "welcome.tryAgain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "welcome.wirelessData": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If iOS asks whether Ask Key may use wireless data, choose WLAN & Cellular."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果系统询问是否允许请⁠旨使用无线数据，请选择“无线局域网与蜂窝网络”。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
