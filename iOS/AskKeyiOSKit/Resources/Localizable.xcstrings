    "list.remove.confirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone stops trusting this Mac at once. Ask Key also tells the Mac, which removes this iPhone when it next checks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 会立即不再信任这台 Mac。请旨也会通知 Mac，Mac 下次检查时会移除这台 iPhone。"
          }
        }
      }
    },
    "list.remove.confirmTitle %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
